# Streamlit Secrets Configuration
# Copy this to ~/.streamlit/secrets.toml locally
# For Streamlit Cloud, add these in the app settings

ESPN_S2 = "your_espn_s2_cookie_here"
SWID = "your_swid_cookie_here"

# Optional: trade history (Supabase project URL and its secret key, never the publishable one)
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "sb_secret_..."
